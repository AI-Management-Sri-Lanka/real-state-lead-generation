# Backend API base URL (without /api/v1 - it's added automatically in api/config.ts)
VITE_API_URL=http://localhost:8001

# OAuth Client ID from Google Cloud Console (Credentials > OAuth 2.0 Client IDs).
# Must be the SAME client ID set as GOOGLE_CLIENT_ID in the backend's .env,
# and its "Authorized JavaScript origins" must include this app's URL
# (e.g. http://localhost:5173 for local dev).
VITE_GOOGLE_CLIENT_ID=329051435081-49ttaaiehuq2m8ie88jm3spagqvs1om1.apps.googleusercontent.com